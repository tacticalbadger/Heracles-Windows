<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK part of the framework name brings the WinRT
         projection that scheduled notifications (reminders) need. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <AssemblyName>Heracles</AssemblyName>
    <RootNamespace>Heracles</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The icon of the program file, and so of its windows and of the
         taskbar. Drawn by tools\make-icon.ps1 from the layers in Icon\. -->
    <ApplicationIcon>Icon\Heracles.ico</ApplicationIcon>
    <!-- The UniFFI bindings marshal buffers with pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF0001: the Fluent theme (ThemeMode) is still flagged as evaluation API. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both produced by "tools\build.ps1 core"; neither is in git. -->
    <Compile Include="..\Generated\heracles_core.cs" Link="Core\heracles_core.cs" />
    <Content Include="..\runtimes\$(RuntimeIdentifier)\native\heracles_core.dll" Link="heracles_core.dll"
             Condition="'$(RuntimeIdentifier)' != ''" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- A picture of the icon beside the program: Windows shows it on the
         app's reminders (AppIdentity in Support\LinkRegistration.cs). -->
    <Content Include="Icon\Heracles.png" Link="Heracles.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Colour emoji in icons and read-only text: WPF draws them in one
         colour (see "Colour emoji" in CLAUDE.md). The package targets .NET
         Core 3.1 and works from .NET 10. -->
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Heracles.Tests" />
  </ItemGroup>

</Project>
