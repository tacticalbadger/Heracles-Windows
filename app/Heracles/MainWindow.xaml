<Window x:Class="Heracles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heracles" Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
        <TextBlock x:Name="LibraryStatus" AutomationProperties.AutomationId="LibraryStatus"
                   FontSize="20" HorizontalAlignment="Center" />
        <TextBlock x:Name="StartupErrorTitle" Text="The library could not be opened"
                   FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Visibility="Collapsed" />
        <TextBlock x:Name="StartupError" AutomationProperties.AutomationId="StartupError"
                   Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"
                   Visibility="Collapsed" />
    </StackPanel>
</Window>
